# SEO Article Writer — Environment Variables
# Copy this file to .env and fill in your keys.
#   cp .env.example .env

# Required: Anthropic API key (https://console.anthropic.com/)
ANTHROPIC_API_KEY=sk-ant-...

# Optional: SerpAPI key (https://serpapi.com/)
# Enables live SERP research + Google Image search for article images.
# Without it, Claude knowledge is used and Unsplash search links are provided.
SERPAPI_KEY=

# Optional: OpenAI key (https://platform.openai.com/api-keys)
# Only used by the Step 6.5 judge, which settles disagreements between the
# writer and the auditor. Setting this switches the judge to a second vendor so
# a dispute is not resolved by the same family of models that caused it.
# Leave blank to keep the Claude judge (claude-opus-5).
OPENAI_API_KEY=

# Optional: which vendor judges disputes. auto | anthropic | openai
# "auto" uses OpenAI when OPENAI_API_KEY is set, otherwise Claude.
JUDGE_PROVIDER=auto

# Optional: the OpenAI model used when the judge is OpenAI.
# Set this to a model your key can actually reach.
OPENAI_JUDGE_MODEL=gpt-5.5
